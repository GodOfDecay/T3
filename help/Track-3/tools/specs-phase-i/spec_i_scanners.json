  ],
  [
   "semgrep-error-medium",
   "_SEMGREP_SEVERITY = {\"ERROR\": \"high\", \"WARNING\": \"medium\", \"INFO\": \"low\"}",
   "_SEMGREP_SEVERITY = {\"ERROR\": \"medium\", \"WARNING\": \"medium\", \"INFO\": \"low\"}"
