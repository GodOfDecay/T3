  [
   "failed-is-ran",
   "        scans[\"semgrep\"], notes[\"semgrep\"] = \"failed\", str(exc)[:300]",
   "        scans[\"semgrep\"], notes[\"semgrep\"] = \"ran\", str(exc)[:300]"
  ],
  [
   "module-prefix-lost",
   "        target = _rel(r.get(\"Target\") or \"\", module_path)",
   "        target = r.get(\"Target\") or \"\""
  ]
 ]
}
